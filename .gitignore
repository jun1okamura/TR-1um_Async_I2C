.venv/
__pycache__/
*.pyc
.pytest_cache/
references/
!results/.gitkeep
.DS_Store
src/sim
*.vcd
*.bak

# ngspice ASCII rawfile outputs under ring_osc/TB/ can be tens of MB
# (e.g. tb_ring_osc.raw was 18.5MB, by far the largest tracked file in
# this repo) -- unlike irsim/*.raw (2-3MB, kept as precedent), these are
# regenerated locally on every run and not worth tracking. Scoped to
# ring_osc/TB/ only so the existing irsim/*.raw precedent is unaffected.
ring_osc/TB/*.raw

# 2026-09-02: same reasoning applied to ngspice/TB/ -- rx_capture_trace.txt
# (24MB, a `wrdata` full-waveform dump) and spice.log (2.3MB) are large,
# fully regeneratable simulation byproducts, not source.
ngspice/TB/*.raw
ngspice/TB/rx_capture_trace.txt
ngspice/TB/spice.log

# iverilog/vvp compiled outputs and their build logs are binaries, not
# source -- regenerate with `iverilog -o <name> ...`.
src/sim_dbg9
src/sim_net
src/sim_net9
src/sim_rtl
src/Verilog.log
