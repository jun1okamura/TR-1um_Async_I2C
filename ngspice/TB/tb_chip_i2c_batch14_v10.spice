.measure tran rx_data_bit4 FIND v(xdut.NC_OUT11) AT=0.000194  $ rx_data == 0xA5 -- bit4
.measure tran rx_data_bit5 FIND v(xdut.NC_OUT12) AT=0.000194  $ rx_data == 0xA5 -- bit5
.measure tran rx_data_bit6 FIND v(xdut.NC_OUT13) AT=0.000194  $ rx_data == 0xA5 -- bit6
.measure tran rx_data_bit7 FIND v(xdut.NC_OUT14) AT=0.000194  $ rx_data == 0xA5 -- bit7
.measure tran busy_after_stop1 FIND v(xdut.NC_CORE_busy) AT=0.000209  $ expect ~0V -- busy cleared after STOP
.measure tran ack_addr_read FIND v(P2) AT=0.0003095  $ expect ~0V -- slave ACKed matching address (read)
.measure tran rw_read FIND v(xdut.NC_CORE_rw) AT=0.0003118  $ expect ~VDD -- rw indicates READ
.measure tran read_byte_bit0 FIND v(P2) AT=0.0003195  $ read byte == 0x3C -- bit0
.measure tran read_byte_bit1 FIND v(P2) AT=0.0003295  $ read byte == 0x3C -- bit1
