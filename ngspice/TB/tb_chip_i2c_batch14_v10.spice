.measure tran busy_after_stop2 FIND v(xdut.NC_CORE_busy) AT=0.000419  $ expect ~0V -- busy cleared after final STOP
.measure tran nack_wrong_addr FIND v(P2) AT=0.0005195  $ expect ~VDD -- unmatched address -> NACK (no slave ack)
.measure tran addr_match_wrong FIND v(xdut.NC_CORE_addr_match) AT=0.0005218  $ expect ~0V -- addr_match not asserted for foreign address
.measure tran busy_after_stop3 FIND v(xdut.NC_CORE_busy) AT=0.000539  $ expect ~0V -- busy cleared after STOP following NACK

