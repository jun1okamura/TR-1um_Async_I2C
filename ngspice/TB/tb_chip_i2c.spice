.measure tran phase_0_rst_900n FIND v(xdut.x2.phase_0) AT=9e-07  $ phase_0 at rst_900n (for comparison -- resets correctly per earlier probes)
.measure tran bit_cnt_0_rst_1200n FIND v(xdut.x2.bit_cnt_0) AT=1.2e-06  $ bit_cnt_0 at rst_1200n
.measure tran phase_0_rst_1200n FIND v(xdut.x2.phase_0) AT=1.2e-06  $ phase_0 at rst_1200n (for comparison -- resets correctly per earlier probes)
.measure tran bit_cnt_0_rst_1600n FIND v(xdut.x2.bit_cnt_0) AT=1.6e-06  $ bit_cnt_0 at rst_1600n
.measure tran phase_0_rst_1600n FIND v(xdut.x2.phase_0) AT=1.6e-06  $ phase_0 at rst_1600n (for comparison -- resets correctly per earlier probes)
.measure tran fine_bitcnt0_t0 FIND v(xdut.x2.bit_cnt_0) AT=1.75e-05  $ bit_cnt_0 fine sweep point 0 (17.5us)
.measure tran fine_ck_t0 FIND v(xdut.x2._156__row1) AT=1.75e-05  $ _156__row1 (shared clock net) fine sweep point 0 (17.5us)
.measure tran fine_rstb_t0 FIND v(xdut.x2._016_) AT=1.75e-05  $ _016_ (RSTB, shared by write-addr critical group) fine sweep point 0 (17.5us)
.measure tran fine_held_t0 FIND v(xdut.x2.rst_scl_domain_held) AT=1.75e-05  $ rst_scl_domain_held fine sweep point 0 (17.5us)
.measure tran fine_qn_t0 FIND v(xdut.x2.rst_stretch_qn) AT=1.75e-05  $ rst_stretch_qn fine sweep point 0 (17.5us)
.measure tran fine_raw_t0 FIND v(xdut.x2._143_) AT=1.75e-05  $ _143_ (rst_scl_domain_raw) fine sweep point 0 (17.5us)
.measure tran fine_clr_t0 FIND v(xdut.x2._144_) AT=1.75e-05  $ _144_ (rst_stretch_clr) fine sweep point 0 (17.5us)
.measure tran fine_d_t0 FIND v(xdut.x2._066_) AT=1.75e-05  $ _066_ (D input to bit_cnt_0's flop) fine sweep point 0 (17.5us)
.measure tran fine_qb_t0 FIND v(xdut.x2._212_) AT=1.75e-05  $ _212_ (QB output of bit_cnt_0's flop) fine sweep point 0 (17.5us)
.measure tran fine_qm_t0 FIND v(xdut.x2.x_505_.qm) AT=1.75e-05  $ internal QM (master latch out) of x_505_ fine sweep point 0 (17.5us)
