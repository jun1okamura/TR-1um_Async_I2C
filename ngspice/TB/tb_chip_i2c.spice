.measure tran tx_DATA_write_bit0 FIND v(P2) AT=0.0001795  $ self-check: this generator's OWN driven bus level, DATA (write) bit0 (expect ~VDD (bit=1))
.measure tran tx_ADDR_R_bit7 FIND v(P2) AT=0.0002295  $ self-check: this generator's OWN driven bus level, ADDR+R bit7 (expect ~VDD (bit=1))
.measure tran tx_ADDR_R_bit6 FIND v(P2) AT=0.0002395  $ self-check: this generator's OWN driven bus level, ADDR+R bit6 (expect ~0V (bit=0))
.measure tran tx_ADDR_R_bit5 FIND v(P2) AT=0.0002495  $ self-check: this generator's OWN driven bus level, ADDR+R bit5 (expect ~VDD (bit=1))
.measure tran tx_ADDR_R_bit4 FIND v(P2) AT=0.0002595  $ self-check: this generator's OWN driven bus level, ADDR+R bit4 (expect ~0V (bit=0))
.measure tran tx_ADDR_R_bit3 FIND v(P2) AT=0.0002695  $ self-check: this generator's OWN driven bus level, ADDR+R bit3 (expect ~0V (bit=0))
.measure tran tx_ADDR_R_bit2 FIND v(P2) AT=0.0002795  $ self-check: this generator's OWN driven bus level, ADDR+R bit2 (expect ~0V (bit=0))
