.measure tran bit_cnt_1_at_start_begin FIND v(xdut.x2.bit_cnt_1) AT=2.001e-06  $ bit_cnt_1 at_start_begin
.measure tran bit_cnt_2_at_start_begin FIND v(xdut.x2.bit_cnt_2) AT=2.001e-06  $ bit_cnt_2 at_start_begin
.measure tran lbp_at_start_begin FIND v(xdut.x2.last_bit_pending) AT=2.001e-06  $ last_bit_pending at_start_begin
