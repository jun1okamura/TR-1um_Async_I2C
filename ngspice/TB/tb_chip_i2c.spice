1_x4 bc1_x5 bc1_x6 bc2_x1 bc2_x2 bc2_x3 bc2_x4 d004_x1 lbp_x1 ck_x1 d_066_e1 d_100_e1 d_111_e1 d_094_e1 d_085_e1 d_098_e1 d_099_e1 d_110_e1 bc0_e1 bc0_qb_e1 d_066_mid d_100_mid d_111_mid d_094_mid d_085_mid d_098_mid d_099_mid d_110_mid bc0_mid bc0_qb_mid d_066_e2pre d_100_e2pre d_111_e2pre d_094_e2pre d_085_e2pre d_098_e2pre d_099_e2pre d_110_e2pre bc0_e2pre bc0_qb_e2pre tl_scl_row2_x1 tl_scl_row2_x2 tl_scl_row2_x3 tl_scl_row2_x4 tl_016_x1 tl_016_x2 tl_016_x3 tl_016_x4 tl_rst_scl_domain_held_x1 tl_rst_scl_domain_held_x2 tl_rst_scl_domain_held_x3 tl_rst_scl_domain_held_x4 tl_rst_stretch_qn_x1 tl_rst_stretch_qn_x2 tl_rst_stretch_qn_x3 tl_rst_stretch_qn_x4 tl_143_x1 tl_143_x2 tl_143_x3 tl_143_x4 tl_144_x1 tl_144_x2 tl_144_x3 tl_144_x4 tl_156_x1 tl_156_x2 tl_156_x3 tl_156_x4 tl_156__row1_x1 tl_156__row1_x2 tl_156__row1_x3 tl_156__row1_x4 g2_143_x1 g2_143_x2 g2_143_x3 g2_143_x4 g2_143_x5 g2_143_x6 g2_143_x7 g2_143_x8 g2_143_x9 g2_143_x10 g2_143_x11 g2_143_x12 g2_143_x13 g2_143_x14 g2_143_x15 g2_143_x16 g2_144_x1 g2_144_x2 g2_144_x3 g2_144_x4 g2_144_x5 g2_144_x6 g2_144_x7 g2_144_x8 g2_144_x9 g2_144_x10 g2_144_x11 g2_144_x12 g2_144_x13 g2_144_x14 g2_144_x15 g2_144_x16 g2_rst_scl_domain_held_x1 g2_rst_scl_domain_held_x2 g2_rst_scl_domain_held_x3 g2_rst_scl_domain_held_x4 g2_rst_scl_domain_held_x5 g2_rst_scl_domain_held_x6 g2_rst_scl_domain_held_x7 g2_rst_scl_domain_held_x8 g2_rst_scl_domain_held_x9 g2_rst_scl_domain_held_x10 g2_rst_scl_domain_held_x11 g2_rst_scl_domain_held_x12 g2_rst_scl_domain_held_x13 g2_rst_scl_domain_held_x14 g2_rst_scl_domain_held_x15 g2_rst_scl_domain_held_x16 g2_rst_stretch_qn_x1 g2_rst_stretch_qn_x2 g2_rst_stretch_qn_x3 g2_rst_stretch_qn_x4 g2_rst_stretch_qn_x5 g2_rst_stretch_qn_x6 g2_rst_stretch_qn_x7 g2_rst_stretch_qn_x8 g2_rst_stretch_qn_x9 g2_rst_stretch_qn_x10 g2_rst_stretch_qn_x11 g2_rst_stretch_qn_x12 g2_rst_stretch_qn_x13 g2_rst_stretch_qn_x14 g2_rst_stretch_qn_x15 g2_rst_stretch_qn_x16 g2_016_x1 g2_016_x2 g2_016_x3 g2_016_x4 g2_016_x5 g2_016_x6 g2_016_x7 g2_016_x8 g2_016_x9 g2_016_x10 g2_016_x11 g2_016_x12 g2_016_x13 g2_016_x14 g2_016_x15 g2_016_x16
  print last_bit_pending_write phase_0_write phase_1_write phase_2_write last_bit_pending_read phase_0_read phase_1_read phase_2_read
  print bit_cnt_0_edge1 bit_cnt_1_edge1 bit_cnt_2_edge1 lbp_edge1 bit_cnt_0_edge2 bit_cnt_1_edge2 bit_cnt_2_edge2 lbp_edge2 bit_cnt_0_edge3 bit_cnt_1_edge3 bit_cnt_2_edge3 lbp_edge3 bit_cnt_0_edge4 bit_cnt_1_edge4 bit_cnt_2_edge4 lbp_edge4 bit_cnt_0_edge5 bit_cnt_1_edge5 bit_cnt_2_edge5 lbp_edge5 bit_cnt_0_edge6 bit_cnt_1_edge6 bit_cnt_2_edge6 lbp_edge6 bit_cnt_0_edge7 bit_cnt_1_edge7 bit_cnt_2_edge7 lbp_edge7 bit_cnt_0_edge8 bit_cnt_1_edge8 bit_cnt_2_edge8 lbp_edge8
  print sda_release_trise

  * rx_data after the write transaction's ACK (expect 0xA5):
  * bit0..7 = ['NC_OUT11', 'NC_OUT12', 'NC_OUT13', 'NC_OUT14', 'NC_OUT6', 'NC_OUT5', 'NC_OUT4', 'NC_OUT3']
  print v(xdut.NC_OUT11) v(xdut.NC_OUT12) v(xdut.NC_OUT13) v(xdut.NC_OUT14) v(xdut.NC_OUT6) v(xdut.NC_OUT5) v(xdut.NC_OUT4) v(xdut.NC_OUT3)

  set filetype=ascii
  * (2026-09-02: dropped the old scl_row0/scl_row1/_079_/_092_/_103_/
  * _104_/_059_/_061_ probes here -- those were auto-generated Yosys net
  * names from the pre-v5 synthesis and no longer exist/no longer refer
  * to the same nodes after resynthesis; comparator-chain logic was
  * already confirmed correct at the netlist level, so they're not
  * needed for ongoing verification. bit_cnt_0/1/2, phase_0/1/2,
  * last_bit_pending, shreg_0-6 are stable RTL-level register names and
  * kept.)
  write tb_chip_i2c.raw v(P1) v(P2) v(P15) v(xdut.NC_OUT11) v(xdut.NC_OUT12) v(xdut.NC_OUT13) v(xdut.NC_OUT14) v(xdut.NC_OUT6) v(xdut.NC_OUT5) v(xdut.NC_OUT4) v(xdut.NC_OUT3) v(xdut.NC_CORE_busy) v(xdut.NC_CORE_addr_match) v(xdut.NC_CORE_rw) i(vvdd) v(xdut.x2.last_bit_pending) v(xdut.x2.phase_0) v(xdut.x2.phase_1) v(xdut.x2.phase_2) v(xdut.x2.shreg_0) v(xdut.x2.shreg_1) v(xdut.x2.shreg_2) v(xdut.x2.shreg_3) v(xdut.x2.shreg_4) v(xdut.x2.shreg_5) v(xdut.x2.shreg_6) v(xdut.x2.bit_cnt_0) v(xdut.x2.bit_cnt_1) v(xdut.x2.bit_cnt_2)

  * interactive viewing (see tb_ring_osc.spice's own note: ignored
  * harmlessly in -b batch mode without a display; run without -b, or
  * `ngspice -b tb_chip_i2c.spice` then load tb_chip_i2c.raw in any
  * viewer, e.g. `ngspice -r tb_chip_i2c.raw` + `plot` at the prompt).
  plot v(P1) v(P2)
  plot v(P15)
  plot v(xdut.NC_OUT11) v(xdut.NC_OUT12) v(xdut.NC_OUT13) v(xdut.NC_OUT14) v(xdut.NC_OUT6) v(xdut.NC_OUT5) v(xdut.NC_OUT4) v(xdut.NC_OUT3)
  plot v(xdut.NC_CORE_busy) v(xdut.NC_CORE_addr_match) v(xdut.NC_CORE_rw)

  * ---- DFFRB slave-hold race diagnostic (bit_cnt_0's flop, x_505_) ----
  * bit_cnt_0 (Q) was seen to collapse from 5V to ~0V exactly in sync with
  * CK's own falling edge between edge1(17us) and edge2(27us) instead of
  * holding through the whole low phase. The earlier point-sample sweep
  * only showed the value AFTER the collapse had already completed (one
  * full 1us sample past it); these plots zoom into the actual transition
  * window (CK is known to fall somewhere between t=21.5us and t=22.5us)
  * so the real shape of the glitch -- fast digital race vs. slow settle,
  * which node moves first, whether QM/net2 (master) stay clean while
  * QS/net5 (slave) alone glitch -- can be read directly off the traces.
  * Widen/narrow with another `xlimit a b` + `plot ...` at the ngspice
  * prompt once the approximate glitch time is visible.
  plot v(xdut.x2._156__row1) v(xdut.x2.bit_cnt_0) xlimit 2.1e-05 2.3e-05
  plot v(xdut.x2.x_505_.qm) v(xdut.x2.x_505_.net2) xlimit 2.1e-05 2.3e-05
  plot v(xdut.x2.x_505_.qs) v(xdut.x2.x_505_.net5) xlimit 2.1e-05 2.3e-05
  plot v(xdut.x2._212_) v(xdut.x2._066_) xlimit 2.1e-05 2.3e-05
  plot v(xdut.x2._156__row1) v(xdut.x2.x_505_.qm) v(xdut.x2.x_505_.qs) v(xdut.x2._212_) v(xdut.x2.bit_cnt_0) xlimit 2.1e-05 2.3e-05
.endc

.end
