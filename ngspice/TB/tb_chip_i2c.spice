.measure tran bit_cnt_2_before_bit7_edge FIND v(xdut.x2.bit_cnt_2) AT=1.22e-05  $ bit_cnt_2 before_bit7_edge
.measure tran lbp_before_bit7_edge FIND v(xdut.x2.last_bit_pending) AT=1.22e-05  $ last_bit_pending before_bit7_edge
