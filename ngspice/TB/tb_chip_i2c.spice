.measure tran phase_0_write FIND v(xdut.x2.phase_0) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran phase_1_write FIND v(xdut.x2.phase_1) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran phase_2_write FIND v(xdut.x2.phase_2) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran last_bit_pending_read FIND v(xdut.x2.last_bit_pending) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_0_read FIND v(xdut.x2.phase_0) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_1_read FIND v(xdut.x2.phase_1) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_2_read FIND v(xdut.x2.phase_2) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge

* ---- diagnostic: bit_cnt_0/1/2 + last_bit_pending numeric trajectory at
* every ADDR+W bit edge (edge1..edge8) ----
.measure tran bit_cnt_0_edge1 FIND v(xdut.x2.bit_cnt_0) AT=1.9e-05  $ bit_cnt_0 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_1_edge1 FIND v(xdut.x2.bit_cnt_1) AT=1.9e-05  $ bit_cnt_1 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_2_edge1 FIND v(xdut.x2.bit_cnt_2) AT=1.9e-05  $ bit_cnt_2 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran lbp_edge1 FIND v(xdut.x2.last_bit_pending) AT=1.9e-05  $ last_bit_pending 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_0_edge2 FIND v(xdut.x2.bit_cnt_0) AT=2.9e-05  $ bit_cnt_0 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_1_edge2 FIND v(xdut.x2.bit_cnt_1) AT=2.9e-05  $ bit_cnt_1 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_2_edge2 FIND v(xdut.x2.bit_cnt_2) AT=2.9e-05  $ bit_cnt_2 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran lbp_edge2 FIND v(xdut.x2.last_bit_pending) AT=2.9e-05  $ last_bit_pending 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_0_edge3 FIND v(xdut.x2.bit_cnt_0) AT=3.9e-05  $ bit_cnt_0 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_1_edge3 FIND v(xdut.x2.bit_cnt_1) AT=3.9e-05  $ bit_cnt_1 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_2_edge3 FIND v(xdut.x2.bit_cnt_2) AT=3.9e-05  $ bit_cnt_2 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran lbp_edge3 FIND v(xdut.x2.last_bit_pending) AT=3.9e-05  $ last_bit_pending 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_0_edge4 FIND v(xdut.x2.bit_cnt_0) AT=4.9e-05  $ bit_cnt_0 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_1_edge4 FIND v(xdut.x2.bit_cnt_1) AT=4.9e-05  $ bit_cnt_1 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_2_edge4 FIND v(xdut.x2.bit_cnt_2) AT=4.9e-05  $ bit_cnt_2 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran lbp_edge4 FIND v(xdut.x2.last_bit_pending) AT=4.9e-05  $ last_bit_pending 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_0_edge5 FIND v(xdut.x2.bit_cnt_0) AT=5.9e-05  $ bit_cnt_0 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_1_edge5 FIND v(xdut.x2.bit_cnt_1) AT=5.9e-05  $ bit_cnt_1 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_2_edge5 FIND v(xdut.x2.bit_cnt_2) AT=5.9e-05  $ bit_cnt_2 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran lbp_edge5 FIND v(xdut.x2.last_bit_pending) AT=5.9e-05  $ last_bit_pending 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_0_edge6 FIND v(xdut.x2.bit_cnt_0) AT=6.9e-05  $ bit_cnt_0 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_1_edge6 FIND v(xdut.x2.bit_cnt_1) AT=6.9e-05  $ bit_cnt_1 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_2_edge6 FIND v(xdut.x2.bit_cnt_2) AT=6.9e-05  $ bit_cnt_2 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran lbp_edge6 FIND v(xdut.x2.last_bit_pending) AT=6.9e-05  $ last_bit_pending 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_0_edge7 FIND v(xdut.x2.bit_cnt_0) AT=7.9e-05  $ bit_cnt_0 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_1_edge7 FIND v(xdut.x2.bit_cnt_1) AT=7.9e-05  $ bit_cnt_1 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_2_edge7 FIND v(xdut.x2.bit_cnt_2) AT=7.9e-05  $ bit_cnt_2 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran lbp_edge7 FIND v(xdut.x2.last_bit_pending) AT=7.9e-05  $ last_bit_pending 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_0_edge8 FIND v(xdut.x2.bit_cnt_0) AT=8.9e-05  $ bit_cnt_0 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran bit_cnt_1_edge8 FIND v(xdut.x2.bit_cnt_1) AT=8.9e-05  $ bit_cnt_1 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran bit_cnt_2_edge8 FIND v(xdut.x2.bit_cnt_2) AT=8.9e-05  $ bit_cnt_2 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran lbp_edge8 FIND v(xdut.x2.last_bit_pending) AT=8.9e-05  $ last_bit_pending 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)

* ---- diagnostic: SDA release slew (pull-up charge time) ----
.measure tran sda_release_trise TRIG v(P2) VAL=1.0 RISE=1 TARG v(P2) VAL=4.5 RISE=1  $ SDA release slew after START, before ADDR+W bit7

.control
  * ngspice only keeps the FULL time-history of a node available for a
  * later "write"/"plot"/vector-slice if it was explicitly "save"d before
  * "run" -- .measure works without this (it evaluates incrementally
  * during the run), which is why a real local run's .measure results
  * for these exact internal nodes succeeded while a later "write"/"plot"
  * of the same nodes (added without a matching "save") failed with
  * "no such vector". Save the full diagnostic node set up front so the
  * .raw file this generates actually contains their waveforms.
  save all

  run

  print rd_bit0 rd_bit1 rd_bit2 rd_bit3 rd_bit4 rd_bit5 rd_bit6 rd_bit7
  print ack0 ack1 ack2 ack3
  print busy_after_start addr_match_write rw_write addr_match_write_x1 addr_match_read rw_read addr_match_read_x1
  print tx_ADDR_W_bit7 tx_ADDR_W_bit6 tx_ADDR_W_bit5 tx_ADDR_W_bit4 tx_ADDR_W_bit3 tx_ADDR_W_bit2 tx_ADDR_W_bit1 tx_ADDR_W_bit0 tx_DATA_write_bit7 tx_DATA_write_bit6 tx_DATA_write_bit5 tx_DATA_write_bit4 tx_DATA_write_bit3 tx_DATA_write_bit2 tx_DATA_write_bit1 tx_DATA_write_bit0 tx_ADDR_R_bit7 tx_ADDR_R_bit6 tx_ADDR_R_bit5 tx_ADDR_R_bit4 tx_ADDR_R_bit3 tx_ADDR_R_bit2 tx_ADDR_R_bit1 tx_ADDR_R_bit0
  print shreg_0_write shreg_1_write shreg_2_write shreg_3_write shreg_4_write shreg_5_write shreg_6_write shreg_0_read shreg_1_read shreg_2_read shreg_3_read shreg_4_read shreg_5_read shreg_6_read
  print phase0_after_start phase1_after_start phase2_after_start bit_cnt_0_at_start_begin bit_cnt_1_at_start_begin bit_cnt_2_at_start_begin lbp_at_start_begin bit_cnt_0_before_bit7_edge bit_cnt_1_before_bit7_edge bit_cnt_2_before_bit7_edge lbp_before_bit7_edge bit_cnt_0_rst_300n phase_0_rst_300n bit_cnt_0_rst_550n phase_0_rst_550n bit_cnt_0_rst_650n phase_0_rst_650n bit_cnt_0_rst_900n phase_0_rst_900n bit_cnt_0_rst_1200n phase_0_rst_1200n bit_cnt_0_rst_1600n phase_0_rst_1600n fine_bitcnt0_t0 fine_ck_t0 fine_rstb_t0 fine_held_t0 fine_qn_t0 fine_raw_t0 fine_clr_t0 fine_d_t0 fine_qb_t0 fine_qm_t0 fine_net2_t0 fine_qs_t0 fine_net5_t0 fine_bitcnt0_t1 fine_ck_t1 fine_rstb_t1 fine_held_t1 fine_qn_t1 fine_raw_t1 fine_clr_t1 fine_d_t1 fine_qb_t1 fine_qm_t1 fine_net2_t1 fine_qs_t1 fine_net5_t1 fine_bitcnt0_t2 fine_ck_t2 fine_rstb_t2 fine_held_t2 fine_qn_t2 fine_raw_t2 fine_clr_t2 fine_d_t2 fine_qb_t2 fine_qm_t2 fine_net2_t2 fine_qs_t2 fine_net5_t2 fine_bitcnt0_t3 fine_ck_t3 fine_rstb_t3 fine_held_t3 fine_qn_t3 fine_raw_t3 fine_clr_t3 fine_d_t3 fine_qb_t3 fine_qm_t3 fine_net2_t3 fine_qs_t3 fine_net5_t3 fine_bitcnt0_t4 fine_ck_t4 fine_rstb_t4 fine_held_t4 fine_qn_t4 fine_raw_t4 fine_clr_t4 fine_d_t4 fine_qb_t4 fine_qm_t4 fine_net2_t4 fine_qs_t4 fine_net5_t4 fine_bitcnt0_t5 fine_ck_t5 fine_rstb_t5 fine_held_t5 fine_qn_t5 fine_raw_t5 fine_clr_t5 fine_d_t5 fine_qb_t5 fine_qm_t5 fine_net2_t5 fine_qs_t5 fine_net5_t5 fine_bitcnt0_t6 fine_ck_t6 fine_rstb_t6 fine_held_t6 fine_qn_t6 fine_raw_t6 fine_clr_t6 fine_d_t6 fine_qb_t6 fine_qm_t6 fine_net2_t6 fine_qs_t6 fine_net5_t6 fine_bitcnt0_t7 fine_ck_t7 fine_rstb_t7 fine_held_t7 fine_qn_t7 fine_raw_t7 fine_clr_t7 fine_d_t7 fine_qb_t7 fine_qm_t7 fine_net2_t7 fine_qs_t7 fine_net5_t7 fine_bitcnt0_t8 fine_ck_t8 fine_rstb_t8 fine_held_t8 fine_qn_t8 fine_raw_t8 fine_clr_t8 fine_d_t8 fine_qb_t8 fine_qm_t8 fine_net2_t8 fine_qs_t8 fine_net5_t8 fine_bitcnt0_t9 fine_ck_t9 fine_rstb_t9 fine_held_t9 fine_qn_t9 fine_raw_t9 fine_clr_t9 fine_d_t9 fine_qb_