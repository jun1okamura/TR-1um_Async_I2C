* ---- copy 13: dt=30n (SDA falls 30n relative to SCL's fall at T0) ----
vsclpad_d13 SCL_PAD_d13 0 PULSE({vdd_val} 0 {T0} 1n 1n 999u 2000u)
vsdapad_d13 SDA_PAD_d13 0 PULSE({vdd_val} 0 {T0+30n} 1n 1n 999u 2000u)
xdet_d13 SCL_PAD_d13 SDA_PAD_d13 RST_N VDD GND sp_d13 raw_d13 held_d13 rstb_d13 SPDET

