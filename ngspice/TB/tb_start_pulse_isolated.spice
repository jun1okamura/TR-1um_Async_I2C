vsdapad_d15 SDA_PAD_d15 0 PULSE({vdd_val} 0 {T0+50n} 1n 1n 999u 2000u)
xdet_d15 SCL_PAD_d15 SDA_PAD_d15 RST_N VDD GND sp_d15 raw_d15 held_d15 rstb_d15 SPDET

