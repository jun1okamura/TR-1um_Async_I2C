.nodeset v(held_d1)=0 v(rstb_d1)={vdd_val} v(held_d2)=0 v(rstb_d2)={vdd_val} v(held_d3)=0 v(rstb_d3)={vdd_val} v(held_d4)=0 v(rstb_d4)={vdd_val} v(held_d5)=0 v(rstb_d5)={vdd_val} v(held_d6)=0 v(rstb_d6)={vdd_val} v(held_d7)=0 v(rstb_d7)={vdd_val} v(held_d8)=0 v(rstb_d8)={vdd_val} v(held_d9)=0 v(rstb_d9)={vdd_val} v(held_d10)=0 v(rstb_d10)={vdd_val} v(held_d11)=0 v(rstb_d11)={vdd_val} v(held_d12)=0 v(rstb_d12)={vdd_val} v(held_d13)=0 v(rstb_d13)={vdd_val} v(held_d14)=0 v(rstb_d14)={vdd_val} v(held_d15)=0 v(rstb_d15)={vdd_val} v(held_d16)=0 v(rstb_d16)={vdd_val} v(held_d17)=0 v(rstb_d17)={vdd_val} v(held_d18)=0 v(rstb_d18)={vdd_val} v(held_d19)=0 v(rstb_d19)={vdd_val} v(held_d20)=0 v(rstb_d20)={vdd_val}

.tran 0.1n 12u

.measure tran sp_peak_d1   MAX v(sp_d1)   FROM='T0-500n' TO='T0+1u'   $ dt=-100n
.measure tran raw_peak_d1  MAX v(raw_d1)  FROM='T0-500n' TO='T0+1u'   $ dt=-100n
.measure tran held_peak_d1 MAX v(held_d1) FROM='T0-500n' TO='T0+2u'   $ dt=-100n
.measure tran rstb_min_d1  MIN v(rstb_d1) FROM='T0-500n' TO='T0+2u'   $ dt=-100n
.measure tran sp_peak_d2   MAX v(sp_d2)   FROM='T0-500n' TO='T0+1u'   $ dt=-50n
.measure tran raw_peak_d2  MAX v(raw_d2)  FROM='T0-500n' TO='T0+1u'   $ dt=-50n
.measure tran held_peak_d2 MAX v(held_d2) FROM='T0-500n' TO='T0+2u'   $ dt=-50n
.measure tran rstb_min_d2  MIN v(rstb_d2) FROM='T0-500n' TO='T0+2u'   $ dt=-50n
.measure tran sp_peak_d3   MAX v(sp_d3)   FROM='T0-500n' TO='T0+1u'   $ dt=-30n
.measure tran raw_peak_d3  MAX v(raw_d3)  FROM='T0-500n' TO='T0+1u'   $ dt=-30n
.measure tran held_peak_d3 MAX v(held_d3) FROM='T0-500n' TO='T0+2u'   $ dt=-30n
.measure tran rstb_min_d3  MIN v(rstb_d3) FROM='T0-500n' TO='T0+2u'   $ dt=-30n
.measure tran sp_peak_d4   MAX v(sp_d4)   FROM='T0-500n' TO='T0+1u'   $ dt=-20n
.measure tran raw_peak_d4  MAX v(raw_d4)  FROM='T0-500n' TO='T0+1u'   $ dt=-20n
.measure tran held_peak_d4 MAX v(held_d4) FROM='T0-500n' TO='T0+2u'   $ dt=-20n
.measure tran rstb_min_d4  MIN v(rstb_d4) FROM='T0-500n' TO='T0+2u'   $ dt=-20n
.measure tran sp_peak_d5   MAX v(sp_d5)   FROM='T0-500n' TO='T0+1u'   $ dt=-10n
.measure tran raw_peak_d5  MAX v(raw_d5)  FROM='T0-500n' TO='T0+1u'   $ dt=-10n
.measure tran held_peak_d5 MAX v(held_d5) FROM='T0-500n' TO='T0+2u'   $ dt=-10n
.measure tran rstb_min_d5  MIN v(rstb_d5) FROM='T0-500n' TO='T0+2u'   $ dt=-10n
.measure tran sp_peak_d6   MAX v(sp_d6)   FROM='T0-500n' TO='T0+1u'   $ dt=-5n
.measure tran raw_peak_d6  MAX v(raw_d6)  FROM='T0-500n' TO='T0+1u'   $ dt=-5n
.measure tran held_peak_d6 MAX v(held_d6) FROM='T0-500n' TO='T0+2u'   $ dt=-5n
.measure tran rstb_min_d6  MIN v(rstb_d6) FROM='T0-500n' TO='T0+2u'   $ dt=-5n
.measure tran sp_peak_d7   MAX v(sp_d7)   FROM='T0-500n' TO='T0+1u'   $ dt=0
.measure tran raw_peak_d7  MAX v(raw_d7)  FROM='T0-500n' TO='T0+1u'   $ dt=0
