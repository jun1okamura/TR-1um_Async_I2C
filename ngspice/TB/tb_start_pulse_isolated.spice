vsclpad_d14 SCL_PAD_d14 0 PULSE({vdd_val} 0 {T0} 1n 1n 999u 2000u)
vsdapad_d14 SDA_PAD_d14 0 PULSE({vdd_val} 0 {T0+40n} 1n 1n 999u 2000u)
xdet_d14 SCL_PAD_d14 SDA_PAD_d14 RST_N VDD GND sp_d14 raw_d14 held_d14 rstb_d14 SPDET

