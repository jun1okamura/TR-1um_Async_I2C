.measure tran shreg_4_write FIND v(xdut.x2.shreg_4) AT=8.9e-05  $ internal address shift-reg bit, right after the ADDR+W last-bit SCL edge
.measure tran shreg_5_write FIND v(xdut.x2.shreg_5) AT=8.9e-05  $ internal address shift-reg bit, right after the ADDR+W last-bit SCL edge
.measure tran shreg_6_write FIND v(xdut.x2.shreg_6) AT=8.9e-05  $ internal address shift-reg bit, right after the ADDR+W last-bit SCL edge
.measure tran shreg_0_read FIND v(xdut.x2.shreg_0) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_1_read FIND v(xdut.x2.shreg_1) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_2_read FIND v(xdut.x2.shreg_2) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_3_read FIND v(xdut.x2.shreg_3) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_4_read FIND v(xdut.x2.shreg_4) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_5_read FIND v(xdut.x2.shreg_5) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge
.measure tran shreg_6_read FIND v(xdut.x2.shreg_6) AT=0.000299  $ internal address shift-reg bit, right after the ADDR+R last-bit SCL edge

* ---- diagnostic: phase-FSM (phase_0/1/2) after START, and bit_cnt/
* last_bit_pending across reset release ----
.measure tran phase0_after_start FIND v(xdut.x2.phase_0) AT=9.5e-06  $ phase bit0 shortly after START
.measure tran phase1_after_start FIND v(xdut.x2.phase_1) AT=9.5e-06  $ phase bit1 shortly after START
.measure tran phase2_after_start FIND v(xdut.x2.phase_2) AT=9.5e-06  $ phase bit2 shortly after START
.measure tran bit_cnt_0_at_start_begin FIND v(xdut.x2.bit_cnt_0) AT=2.001e-06  $ bit_cnt_0 at_start_begin
.measure tran bit_cnt_1_at_start_begin FIND v(xdut.x2.bit_cnt_1) AT=2.001e-06  $ bit_cnt_1 at_start_begin
.measure tran bit_cnt_2_at_start_begin FIND v(xdut.x2.bit_cnt_2) AT=2.001e-06  $ bit_cnt_2 at_start_begin
.measure tran lbp_at_start_begin FIND v(xdut.x2.last_bit_pending) AT=2.001e-06  $ last_bit_pending at_start_begin
.measure tran bit_cnt_0_before_bit7_edge FIND v(xdut.x2.bit_cnt_0) AT=1.22e-05  $ bit_cnt_0 before_bit7_edge
.measure tran bit_cnt_1_before_bit7_edge FIND v(xdut.x2.bit_cnt_1) AT=1.22e-05  $ bit_cnt_1 before_bit7_edge
.measure tran bit_cnt_2_before_bit7_edge FIND v(xdut.x2.bit_cnt_2) AT=1.22e-05  $ bit_cnt_2 before_bit7_edge
.measure tran lbp_before_bit7_edge FIND v(xdut.x2.last_bit_pending) AT=1.22e-05  $ last_bit_pending before_bit7_edge
.measure tran bit_cnt_0_rst_300n FIND v(xdut.x2.bit_cnt_0) AT=3e-07  $ bit_cnt_0 at rst_300n
.measure tran phase_0_rst_300n FIND v(xdut.x2.phase_0) AT=3e-07  $ phase_0 at rst_300n (for comparison)
.measure tran bit_cnt_0_rst_550n FIND v(xdut.x2.bit_cnt_0) AT=5.5e-07  $ bit_cnt_0 at rst_550n
.measure tran phase_0_rst_550n FIND v(xdut.x2.phase_0) AT=5.5e-07  $ phase_0 at rst_550n (for comparison)
.measure tran bit_cnt_0_rst_650n FIND v(xdut.x2.bit_cnt_0) AT=6.5e-07  $ bit_cnt_0 at rst_650n
.measure tran phase_0_rst_650n FIND v(xdut.x2.phase_0) AT=6.5e-07  $ phase_0 at rst_650n (for comparison)
.measure tran bit_cnt_0_rst_900n FIND v(xdut.x2.bit_cnt_0) AT=9e-07  $ bit_cnt_0 at rst_900n
.measure tran phase_0_rst_900n FIND v(xdut.x2.phase_0) AT=9e-07  $ phase_0 at rst_900n (for comparison)
.measure tran bit_cnt_0_rst_1200n FIND v(xdut.x2.bit_cnt_0) AT=1.2e-06  $ bit_cnt_0 at rst_1200n
.measure tran phase_0_rst_1200n FIND v(xdut.x2.phase_0) AT=1.2e-06  $ phase_0 at rst_1200n (for comparison)
.measure tran bit_cnt_0_rst_1600n FIND v(xdut.x2.bit_cnt_0) AT=1.6e-06  $ bit_cnt_0 at rst_1600n
.measure tran phase_0_rst_1600n FIND v(xdut.x2.phase_0) AT=1.6e-06  $ phase_0 at rst_1600n (for comparison)

* ---- diagnostic: comparator-chain nodes (last_bit_pending/phase_0-2)
* right after each address byte's last-bit SCL edge ----
.measure tran last_bit_pending_write FIND v(xdut.x2.last_bit_pending) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran phase_0_write FIND v(xdut.x2.phase_0) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran phase_1_write FIND v(xdut.x2.phase_1) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran phase_2_write FIND v(xdut.x2.phase_2) AT=8.9e-05  $ comparator-chain node, right after the ADDR+W last-bit SCL edge
.measure tran last_bit_pending_read FIND v(xdut.x2.last_bit_pending) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_0_read FIND v(xdut.x2.phase_0) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_1_read FIND v(xdut.x2.phase_1) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge
.measure tran phase_2_read FIND v(xdut.x2.phase_2) AT=0.000299  $ comparator-chain node, right after the ADDR+R last-bit SCL edge

* ---- diagnostic: bit_cnt_0/1/2 + last_bit_pending trajectory at every
* ADDR+W bit edge (edge1..edge8) ----
.measure tran bit_cnt_0_edge1 FIND v(xdut.x2.bit_cnt_0) AT=1.9e-05  $ bit_cnt_0 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_1_edge1 FIND v(xdut.x2.bit_cnt_1) AT=1.9e-05  $ bit_cnt_1 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_2_edge1 FIND v(xdut.x2.bit_cnt_2) AT=1.9e-05  $ bit_cnt_2 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran lbp_edge1 FIND v(xdut.x2.last_bit_pending) AT=1.9e-05  $ last_bit_pending 2us after ADDR+W bit7's SCL rising edge (edge 1 of 8)
.measure tran bit_cnt_0_edge2 FIND v(xdut.x2.bit_cnt_0) AT=2.9e-05  $ bit_cnt_0 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_1_edge2 FIND v(xdut.x2.bit_cnt_1) AT=2.9e-05  $ bit_cnt_1 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_2_edge2 FIND v(xdut.x2.bit_cnt_2) AT=2.9e-05  $ bit_cnt_2 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran lbp_edge2 FIND v(xdut.x2.last_bit_pending) AT=2.9e-05  $ last_bit_pending 2us after ADDR+W bit6's SCL rising edge (edge 2 of 8)
.measure tran bit_cnt_0_edge3 FIND v(xdut.x2.bit_cnt_0) AT=3.9e-05  $ bit_cnt_0 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_1_edge3 FIND v(xdut.x2.bit_cnt_1) AT=3.9e-05  $ bit_cnt_1 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_2_edge3 FIND v(xdut.x2.bit_cnt_2) AT=3.9e-05  $ bit_cnt_2 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran lbp_edge3 FIND v(xdut.x2.last_bit_pending) AT=3.9e-05  $ last_bit_pending 2us after ADDR+W bit5's SCL rising edge (edge 3 of 8)
.measure tran bit_cnt_0_edge4 FIND v(xdut.x2.bit_cnt_0) AT=4.9e-05  $ bit_cnt_0 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_1_edge4 FIND v(xdut.x2.bit_cnt_1) AT=4.9e-05  $ bit_cnt_1 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_2_edge4 FIND v(xdut.x2.bit_cnt_2) AT=4.9e-05  $ bit_cnt_2 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran lbp_edge4 FIND v(xdut.x2.last_bit_pending) AT=4.9e-05  $ last_bit_pending 2us after ADDR+W bit4's SCL rising edge (edge 4 of 8)
.measure tran bit_cnt_0_edge5 FIND v(xdut.x2.bit_cnt_0) AT=5.9e-05  $ bit_cnt_0 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_1_edge5 FIND v(xdut.x2.bit_cnt_1) AT=5.9e-05  $ bit_cnt_1 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_2_edge5 FIND v(xdut.x2.bit_cnt_2) AT=5.9e-05  $ bit_cnt_2 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran lbp_edge5 FIND v(xdut.x2.last_bit_pending) AT=5.9e-05  $ last_bit_pending 2us after ADDR+W bit3's SCL rising edge (edge 5 of 8)
.measure tran bit_cnt_0_edge6 FIND v(xdut.x2.bit_cnt_0) AT=6.9e-05  $ bit_cnt_0 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_1_edge6 FIND v(xdut.x2.bit_cnt_1) AT=6.9e-05  $ bit_cnt_1 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_2_edge6 FIND v(xdut.x2.bit_cnt_2) AT=6.9e-05  $ bit_cnt_2 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran lbp_edge6 FIND v(xdut.x2.last_bit_pending) AT=6.9e-05  $ last_bit_pending 2us after ADDR+W bit2's SCL rising edge (edge 6 of 8)
.measure tran bit_cnt_0_edge7 FIND v(xdut.x2.bit_cnt_0) AT=7.9e-05  $ bit_cnt_0 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_1_edge7 FIND v(xdut.x2.bit_cnt_1) AT=7.9e-05  $ bit_cnt_1 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_2_edge7 FIND v(xdut.x2.bit_cnt_2) AT=7.9e-05  $ bit_cnt_2 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran lbp_edge7 FIND v(xdut.x2.last_bit_pending) AT=7.9e-05  $ last_bit_pending 2us after ADDR+W bit1's SCL rising edge (edge 7 of 8)
.measure tran bit_cnt_0_edge8 FIND v(xdut.x2.bit_cnt_0) AT=8.9e-05  $ bit_cnt_0 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran bit_cnt_1_edge8 FIND v(xdut.x2.bit_cnt_1) AT=8.9e-05  $ bit_cnt_1 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran bit_cnt_2_edge8 FIND v(xdut.x2.bit_cnt_2) AT=8.9e-05  $ bit_cnt_2 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)
.measure tran lbp_edge8 FIND v(xdut.x2.last_bit_pending) AT=8.9e-05  $ last_bit_pending 2us after ADDR+W bit0's SCL rising edge (edge 8 of 8)

* ---- diagnostic: SDA release slew (pull-up charge time) ----
.measure tran sda_release_trise TRIG v(P2) VAL=1.0 RISE=1 TARG v(P2) VAL=4.5 RISE=1  $ SDA release slew after START, before ADDR+W bit7

.control
  save all
  run

  print rd_bit0 rd_bit1 rd_bit2 rd_bit3 rd_bit4 rd_bit5 rd_bit6 rd_bit7
  print ack0 ack1 ack2 ack3
  print busy_after_start addr_match_write rw_write addr_match_write_x1 addr_match_read rw_read addr_match_read_x1
  print tx_ADDR_W_bit7 tx_ADDR_W_bit6 tx_ADDR_W_bit5 tx_ADDR_W_bit4 tx_ADDR_W_bit3 tx_ADDR_W_bit2 tx_ADDR_W_bit1 tx_ADDR_W_bit0 tx_DATA_write_bit7 tx_DATA_write_bit6 tx_DATA_write_bit5 tx_DATA_write_bit4 tx_DATA_write_bit3 tx_DATA_write_bit2 tx_DATA_write_bit1 tx_DATA_write_bit0 tx_ADDR_R_bit7 tx_ADDR_R_bit6 tx_ADDR_R_bit5 tx_ADDR_R_bit4 tx_ADDR_R_bit3 tx_ADDR_R_bit2 tx_ADDR_R_bit1 tx_ADDR_R_bit0
  print shreg_0_write shreg_1_write shreg_2_write shreg_3_write shreg_4_write shreg_5_write shreg_6_write shreg_0_read shreg_1_read shreg_2_read shreg_3_read shreg_4_read shreg_5_read shreg_6_read
  print phase0_after_start phase1_after_start phase2_after_start bit_cnt_0_at_start_begin bit_cnt_1_at_start_begin bit_cnt_2_at_start_begin lbp_at_start_begin bit_cnt_0_before_bit7_edge bit_cnt_1_before_bit7_edge bit_cnt_2_before_bit7_edge lbp_before_bit7_edge bit_cnt_0_rst_300n phase_0_rst_300n bit_cnt_0_rst_550n phase_0_rst_550n bit_cnt_0_rst_650n phase_0_rst_650n bit_cnt_0_rst_900n phase_0_rst_900n bit_cnt_0_rst_1200n phase_0_rst_1200n bit_cnt_0_rst_1600n phase_0_rst_1600n
  print last_bit_pending_write phase_0_write phase_1_write phase_2_write last_bit_pending_read phase_0_read phase_1_read phase_2_read
  print bit_cnt_0_edge1 bit_cnt_1_edge1 bit_cnt_2_edge1 lbp_edge1 bit_cnt_0_edge2 bit_cnt_1_edge2 bit_cnt_2_edge2 lbp_edge2 bit_cnt_0_edge3 bit_cnt_1_edge3 bit_cnt_2_edge3 lbp_edge3 bit_cnt_0_edge4 bit_cnt_1_edge4 bit_cnt_2_edge4 lbp_edge4 bit_cnt_0_edge5 bit_cnt_1_edge5 bit_cnt_2_edge5 lbp_edge5 bit_cnt_0_edge6 bit_cnt_1_edge6 bit_cnt_2_edge6 lbp_edge6 bit_cnt_0_edge7 bit_cnt_1_edge7 bit_cnt_2_edge7 lbp_edge7 bit_cnt_0_edge8 bit_cnt_1_edge8 bit_cnt_2_edge8 lbp_edge8
  print sda_release_trise

  * rx_data after the write transaction's ACK (expect 0xA5):
  * bit0..7 = ['NC_OUT4', 'NC_OUT12', 'NC_OUT14', 'NC_OUT5', 'NC_OUT6', 'NC_OUT3', 'NC_OUT11', 'NC_OUT13']
  print v(xdut.NC_OUT4) v(xdut.NC_OUT12) v(xdut.NC_OUT14) v(xdut.NC_OUT5) v(xdut.NC_OUT6) v(xdut.NC_OUT3) v(xdut.NC_OUT11) v(xdut.NC_OUT13)

  set filetype=ascii
  write tb_chip_i2c_v10.raw v(P1) v(P2) v(P15) v(xdut.NC_OUT4) v(xdut.NC_OUT12) v(xdut.NC_OUT14) v(xdut.NC_OUT5) v(xdut.NC_OUT6) v(xdut.NC_OUT3) v(xdut.NC_OUT11) v(xdut.NC_OUT13) v(xdut.NC_CORE_busy) v(xdut.NC_CORE_addr_match) v(xdut.NC_CORE_rw) i(vvdd) v(xdut.x2.last_bit_pending) v(xdut.x2.phase_0) v(xdut.x2.phase_1) v(xdut.x2.phase_2) v(xdut.x2.shreg_0) v(xdut.x2.shreg_1) v(xdut.x2.shreg_2) v(xdut.x2.shreg_3) v(xdut.x2.shreg_4) v(xdut.x2.shreg_5) v(xdut.x2.shreg_6) v(xdut.x2.bit_cnt_0) v(xdut.x2.bit_cnt_1) v(xdut.x2.bit_cnt_2)

  * interactive viewing (ignored harmlessly in -b batch mode without a
  * display; run without -b, or `ngspice -b tb_chip_i2c_v10.spice` then
  * load tb_chip_i2c_v10.raw in any viewer, e.g.
  * `ngspice -r tb_chip_i2c_v10.raw` + `plot` at the prompt).
  plot v(P1) v(P2)
  plot v(P15)
  plot v(xdut.NC_OUT4) v(xdut.NC_OUT12) v(xdut.NC_OUT14) v(xdut.NC_OUT5) v(xdut.NC_OUT6) v(xdut.NC_OUT3) v(xdut.NC_OUT11) v(xdut.NC_OUT13)
  plot v(xdut.NC_CORE_busy) v(xdut.NC_CORE_addr_match) v(xdut.NC_CORE_rw)
.endc

.end
