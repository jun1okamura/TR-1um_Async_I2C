xu_sda_s VDD s_in sda_target sda_lat_en GND AND2_X1
xu_sda_r VDD r_in sda_target_n sda_lat_en GND AND2_X1
xu_sda_q VDD sda_d r_in qn_sda GND NOR2
xu_sda_qn VDD qn_sda s_in sda_d GND NOR2
xu_inv_scl VDD scl_row2 scl_n GND INV_X1
xu_lat_q VDD busy _077_ qn GND NOR2
xu_lat_qn VDD qn _167_ busy GND NOR2
xu_rst_stretch_q VDD rst_scl_domain_held _144_ rst_stretch_qn GND NOR2
xu_rst_stretch_qn VDD rst_stretch_qn _143_ rst_scl_domain_held GND NOR2
xu_buf_scl_row2 VDD scl_buf scl_row2 GND BUF_X1
