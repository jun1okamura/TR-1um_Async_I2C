VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MANUFACTURINGGRID 0.05 ;

UNITS
    DATABASE MICRONS 1000 ;
END UNITS

SITE CoreSite
    CLASS CORE ;
    SIZE 5.400 BY 64.800 ;
END CoreSite

MACRO INV_X1
    CLASS CORE ;
    FOREIGN INV_X1 0.0 0.0 ;
    ORIGIN 0.0 0.0 ;
    SIZE 16.200 BY 64.800 ;
    SITE CoreSite ;

    PIN GND
        DIRECTION INOUT ;
        USE GROUND ;
        PORT
            LAYER M1 ;
                RECT 0.000 1.100 16.200 3.700 ;
        END
    END GND

    PIN VDD
        DIRECTION INOUT ;
        USE POWER ;
        PORT
            LAYER M1 ;
                RECT 0.000 61.100 16.200 63.700 ;
        END
    END VDD

    PIN A
        DIRECTION INPUT ;
        USE SIGNAL ;
        PORT
            LAYER M2 ;
                RECT 1.000 28.000 4.400 31.400 ;
        END
    END A

    PIN Y
        DIRECTION OUTPUT ;
        USE SIGNAL ;
        PORT
            LAYER M2 ;
                RECT 11.800 28.000 15.200 31.400 ;
        END
    END Y

    OBS
        LAYER M1 ;
            POLYGON 2.100 3.700  2.100 9.900  4.700 9.900  4.700 3.700 ;
            POLYGON 1.000 28.000  1.000 36.500  3.600 36.500  3.600 31.400  4.400 31.400  4.400 28.000 ;
            POLYGON 6.100 6.500  6.100 9.900  13.400 9.900  13.400 28.000  11.800 28.000  11.800 31.400  13.400 31.400  13.400 44.900  4.700 44.900  4.700 58.300  7.300 58.300  7.300 46.700  15.200 46.700  15.200 6.500 ;
            POLYGON 0.700 48.100  0.700 61.100  3.300 61.100  3.300 48.100 ;
    END

END INV_X1
